{
  "name": "Mount Olympus · The Divine Mountain",
  "description": "The mountain beneath Thunder Peak. Four levels descending from the storm belt to the foundation. Shattered pillars, the Pantheon ledge with twelve doorways, the great hall of assembly, and the worn path of ascent carved by centuries of pilgrims.",
  "levels": [
    {
      "id": "storm-belt",
      "name": "The Storm Belt",
      "description": "Clouds spiral around the upper peak. Lightning cracks the air. The wind carries the voices of oaths sworn and broken.",
      "height": 140,
      "walls": {
        "material": "storm_grey"
      },
      "floor": {
        "material": "marble_dark"
      },
      "objects": [
        { "type": "shattered_pillar", "x": 120, "y": 30 },
        { "type": "shattered_pillar", "x": 620, "y": 30 },
        { "type": "offering_bowl", "x": 360, "y": 60 }
      ],
      "inscriptions": [
        {
          "text": "THE STORM REMEMBERS EVERY OATH",
          "x": 230,
          "y": 100,
          "fontSize": 7,
          "color": "rgba(180,190,220,0.35)",
          "fontFamily": "'Cinzel',serif",
          "z": 6
        }
      ],
      "atmosphere": {
        "canvas": "storm_clouds",
        "particles": [
          { "type": "wind", "count": 15, "color": "rgba(180,190,210,0.1)", "minSize": 1, "maxSize": 2 }
        ]
      }
    },
    {
      "id": "pantheon-ledge",
