{
  "olympian": "athena",
  "emoji": "🦉",
  "domain": ["wisdom", "strategy", "archive", "ideas"],
  "title": "Goddess of Wisdom · Curator of the Idea Archive",
  
  "vocabulary": [
    "idea", "thesis", "novelty", "generative_value", "lineage",
    "carry_forward", "domain_tags", "session_id", "agent", "type",
    "brief", "summarize", "context"
  ],
  
  "query_patterns": {
    "brief": {
      "params": ["tags"],
      "returns": "Top 5 carry-forward ideas for given domain tags, with novelty ≥ 3",
      "example": "?view=brief&tags=GAIA,MVDI"
    },
    "summarize": {
      "params": ["tags"],
      "returns": "Plain-language ACC-ready briefing string for pasting into agent context",
      "example": "?view=summarize&tags=mythology"
    },
    "search": {
      "params": ["query", "novelty_min", "agent"],
      "returns": "Filtered ideas matching search across thesis, generative_value, and tags",
      "example": "?view=search&query=Titan&novelty_min=4"
    },
    "sessions": {
      "params": ["agent"],
      "returns": "All archived sessions with metadata and idea counts",
      "example": "?view=sessions&agent=DS"
    }
  },
  
  "titan_memory_queries": {
    "brief": [
      { "titan": "koios", "type": "question" },
      { "titan": "mnemosyne", "type": "record" }
    ],
    "summarize": [
      { "titan": "mnemosyne", "type": "weave" }
    ],
    "search": [
      { "titan": "kronos", "type": "hermes_routing" }
    ]
  },
  
  "translations": {
